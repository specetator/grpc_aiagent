# 复制为 .env.local，仅填写本机值；不要提交 .env.local。
SPARK_PUSH_MYSQL_PASSWORD=replace-with-a-local-password

# 可选：启用管理页面登录。留空即关闭管理账号。
SPARK_PUSH_ADMIN_ACCOUNT=
SPARK_PUSH_ADMIN_PASSWORD=

# Kernel Agent 集成（Pi runtime）：开启后启动 hermes_bridge，并指向本机 gateway。
# API Key 与 Kernel Agent gateway / 旧 Hermes API_SERVER_KEY 相同，不要提交。
SPARK_PUSH_HERMES_ENABLED=false
SPARK_PUSH_HERMES_BASE_URL=http://127.0.0.1:8643/v1
SPARK_PUSH_HERMES_API_KEY=
SPARK_PUSH_HERMES_MODEL=kernel-agent
SPARK_PUSH_HERMES_STREAMING=true

# Kernel Agent product options; legacy SPARK_PUSH_PI_* settings remain supported.
# SPARK_PUSH_KERNEL_COMMAND=/absolute/path/to/kernel-agent
# SPARK_PUSH_KERNEL_PROVIDER=cli-relay
# SPARK_PUSH_KERNEL_MODEL=<configured-provider-model-id>
KERNEL_AGENT_SUBAGENTS_ENABLED=true
KERNEL_AGENT_MAX_CHILDREN=4
KERNEL_AGENT_CHILD_TIMEOUT_MS=120000

# Shared room CANN Agent is opt-in; use an isolated absolute storage root.
SPARK_PUSH_ROOM_AGENT_ENABLED=false
SPARK_PUSH_ROOM_WORKSPACE_ROOT=
# Optional administrator-owned Python runner, executed in bubblewrap.
# Blank means unavailable, never implicitly passed.
SPARK_PUSH_ROOM_TEST_RUNNER=
