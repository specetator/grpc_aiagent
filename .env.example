# 复制为 .env.local，仅填写本机值；不要提交 .env.local。
SPARK_PUSH_MYSQL_PASSWORD=replace-with-a-local-password

# 可选：启用管理页面登录。留空即关闭管理账号。
SPARK_PUSH_ADMIN_ACCOUNT=
SPARK_PUSH_ADMIN_PASSWORD=

# Hermes Agent（Windows）集成：开启后启动 hermes_bridge；API Key 不要提交。
SPARK_PUSH_HERMES_ENABLED=false
SPARK_PUSH_HERMES_BASE_URL=http://host.docker.internal:8642/v1
SPARK_PUSH_HERMES_API_KEY=
SPARK_PUSH_HERMES_MODEL=hermes-agent
SPARK_PUSH_HERMES_STREAMING=true
